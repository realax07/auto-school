# Секреты и состояние — вне контекста сборки (NFR-14, INC-006)
.env*
!.env.example
deploy/tls/
data/

# Git и локальные окружения
.git
.gitignore
.venv
__pycache__/
*.pyc
.pytest_cache/

# Тесты в образ НЕ поставляются (MAJ-1 design.md): доставка —
# read-only монтирование tests/ на время прогона (container_test.sh/CI)
tests/

# Прочее, не нужное рантайму
node_modules/

# Vue workspace (Спринт 9, ADR-008, задача 2.2): сборка в образе идет из
# манифестов (npm ci в frontend-builder), локальные зависимости и dist
# (артефакт сборки ОБРАЗА) — вне контекста
frontend/vue/node_modules/
frontend/vue/dist/
# Спринт 17 (CR-fix CI docker-build): сгенерированный pdd-data — ТОЛЬКО
# артефакт `npm run build` frontend-builder-стадии (генератор 17.2.1 делает
# полную перезапись каталога). Локальная папка (gitignored, может быть
# stale от ранней итерации) в контекст не попадает — runtime-стадия берет
# ее одним COPY --from=frontend-builder по каноническому пути потребителя.
frontend/vue/src/pages/cabinet/pdd-data/
ai-bridge-config/
