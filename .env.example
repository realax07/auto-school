# Конфигурация окружения (скопируйте в .env — .env в репозиторий не попадает, NFR-3)

# Логин администратора админки
ADMIN_USER=admin

# bcrypt-хэш пароля администратора (НЕ открытый пароль).
# Генерация хэша:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'пароль', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Секретный ключ приложения
SECRET=
