# Конфигурация окружения (скопируйте в .env — .env в репозиторий не попадает, NFR-3)

# Логин администратора админки
ADMIN_USER=admin

# bcrypt-хэш пароля администратора (НЕ открытый пароль).
# Генерация хэша:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'пароль', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Секретный ключ приложения
SECRET=

# ─── Контейнерный контур (docker-compose.yml, Спринт 6 / ADR-006) ───
# Используется ТОЛЬКО compose-деплоем (deploy/container-README.md);
# bare-metal systemd эти переменные не читает.

# Креды MinIO (сервис minio читает из этого же env_file).
# ЗАПРЕЩЕНЫ дефолтные minioadmin/minioadmin (арх-ревью) — задайте свои значения.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Каталог хоста с TLS-сертификатами nginx (cert.pem/key.pem); монтируется
# в /etc/nginx/tls read-only. Вне git и вне образов (INC-006).
TLS_DIR=./deploy/tls


# MinIO (обязательно при docker compose up: без этих переменных стек не стартует)
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password_min
